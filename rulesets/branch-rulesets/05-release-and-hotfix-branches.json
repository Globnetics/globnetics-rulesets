{
  "_comment": "Globnetics Release & Staging Branch Protection: Protects release branches (release/*, staging). Requires 1 approval, CODEOWNERS sign-off, thread resolution, passing integration status checks, and prevents branch deletion and force-pushes during release preparation.",
  "name": "Globnetics - Release & Staging Protection",
  "target": "branch",
  "enforcement": "evaluate",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/release/*", "refs/heads/staging"],
      "exclude": []
    }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 1,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": true,
        "require_last_push_approval": true,
        "required_review_thread_resolution": true
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          { "context": "ci/e2e-tests" },
          { "context": "ci/build" }
        ]
      }
    }
  ]
}
